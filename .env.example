# Bug Reproduction Engine — Environment Configuration

# Server Ports
PORT=8080

# Database
# Leave unset to auto-use embedded PGlite WASM Postgres database at .data/pgdata
# DATABASE_URL=postgres://user:password@localhost:5432/bugrepro

# ─── AI Provider / LLM Configuration ──────────────────────────────────────────
# Choose ONE of the following options, or configure via UI at http://localhost:5000/settings

# Option 1: OpenAI
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Option 2: Groq (Free / Fast open-source models)
# GROQ_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile

# Option 3: OpenRouter
# OPENROUTER_API_KEY=sk-or-v1-...
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct

# Option 4: Ollama (Local models, no API key needed)
# Ollama runs locally at http://localhost:11434/v1
# Configure Ollama directly via the Settings page at http://localhost:5000/settings
